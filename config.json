{
  "voz": "es-CL-LorenzoNeural",
  "rate": "-5%",
  "pitch": "-6Hz",
  "umbral_voz": 0.01,
  "navegador": "%LOCALAPPDATA%/Programs/Opera GX/opera.exe",
  "apps": [
    {"nombre": "opera gx", "alias": ["opera", "navegador"],
     "abrir": "%LOCALAPPDATA%/Programs/Opera GX/opera.exe", "cerrar": "opera.exe"},
    {"nombre": "blender",
     "abrir": "D:/Blender/blender-launcher.exe", "cerrar": "blender.exe"},
    {"nombre": "celestial",
     "abrir": "%LOCALAPPDATA%/Celestial/celestial.exe", "cerrar": "celestial.exe"},
    {"nombre": "discord",
     "abrir": "%LOCALAPPDATA%/Discord/Discord.exe", "cerrar": "Discord.exe", "forzar": true},
    {"nombre": "modrinth", "alias": ["modrinth app"],
     "abrir": "%LOCALAPPDATA%/Modrinth App/Modrinth App.exe", "cerrar": "Modrinth App.exe"},
    {"nombre": "itero", "alias": ["the itero coach", "itero coach", "itero"],
     "abrir": "D:/iTero Drafting Coach Electron/The iTero Coach.exe", "cerrar": "The iTero Coach.exe"},
    {"nombre": "itunes",
     "abrir": "C:/Program Files (x86)/iTunes/iTunes.exe", "cerrar": "iTunes.exe"},
    {"nombre": "edge", "alias": ["microsoft edge"],
     "abrir": "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe", "cerrar": "msedge.exe"},
    {"nombre": "nvidia app", "alias": ["nvidia"],
     "abrir": "C:/Program Files/NVIDIA Corporation/NVIDIA App/CEF/NVIDIA App.exe", "cerrar": "NVIDIA App.exe"},
    {"nombre": "obs", "alias": ["obs studio"],
     "abrir": "D:/obs-studio/bin/64bit/obs64.exe", "cerrar": "obs64.exe"},
    {"nombre": "steam",
     "abrir": "D:/Steam/Steam.exe", "cerrar": "steam.exe", "forzar": true},
    {"nombre": "vlc", "alias": ["vlc media player"],
     "abrir": "C:/Program Files/VideoLAN/VLC/vlc.exe", "cerrar": "vlc.exe"},
    {"nombre": "riot client", "alias": ["cliente de riot", "riot"],
     "abrir": "D:/Riot Games/Riot Client/RiotClientServices.exe",
     "cerrar": ["RiotClientServices.exe", "RiotClientUx.exe", "RiotClientUxRender.exe"],
     "forzar": true, "confirmar": true},
    {"nombre": "league of legends", "alias": ["league", "lol", "liga de leyendas", "lolcito"],
     "abrir": ["D:/Riot Games/Riot Client/RiotClientServices.exe",
               "--launch-product=league_of_legends", "--launch-patchline=live"],
     "cerrar": ["LeagueClient.exe", "LeagueClientUx.exe", "League of Legends.exe"],
     "forzar": true, "confirmar": true},
    {"nombre": "teamfight tactics", "alias": ["tft"],
     "abrir": ["D:/Riot Games/Riot Client/RiotClientServices.exe",
               "--launch-product=bacon", "--launch-patchline=live"],
     "cerrar": ["LeagueClient.exe", "LeagueClientUx.exe", "League of Legends.exe"],
     "forzar": true, "confirmar": true},
    {"nombre": "visual studio code", "alias": ["vs code"],
     "abrir": "code", "cerrar": "Code.exe"},
    {"nombre": "bloc de notas", "abrir": "notepad", "cerrar": "notepad.exe"},
    {"nombre": "calculadora", "abrir": "calc"},
    {"nombre": "explorador", "abrir": "explorer"},
    {"nombre": "spotify", "abrir": "spotify", "cerrar": "Spotify.exe", "forzar": true}
  ],
  "carpetas": {
    "descargas": "~/Downloads",
    "documentos": "~/Documents",
    "escritorio": "~/Desktop",
    "proyecto": "~/Desktop/Jarvis"
  },
  "rutinas": [
    {"nombre": "trabajo",
     "frases": ["vamos a trabajar", "vamo a trabajar", "vamos trabajar", "modo trabajo"],
     "sin_jarvis": true,
     "mensaje": "Modo trabajo activado.",
     "acciones": [{"abrir": "visual studio code"}, {"abrir": "opera gx"}]},
    {"nombre": "juego",
     "frases": ["vamos a jugar", "vamo a jugar", "modo juego"],
     "sin_jarvis": true,
     "mensaje": "Modo juego activado.",
     "acciones": [{"abrir": "discord"}, {"abrir": "steam"}]},
    {"nombre": "estudio",
     "frases": ["modo estudio", "vamos a estudiar"],
     "mensaje": "Modo estudio activado.",
     "acciones": [{"cerrar": "discord"}, {"cerrar": "steam"}, {"volumen": 20},
                  {"abrir": "opera gx"}]},
    {"nombre": "buenas noches",
     "frases": ["buenas noches", "modo noche", "me voy a dormir"],
     "mensaje": "Buenas noches. Que descanses.",
     "acciones": [{"cerrar": "discord"}, {"cerrar": "steam"}, {"cerrar": "obs"},
                  {"cerrar": "blender"}, {"volumen": 15}, {"bloquear": true}]}
  ],
  "paginas": {
    "youtube": "https://www.youtube.com",
    "gmail": "https://mail.google.com",
    "github": "https://github.com"
  },
  "atajos": {
    "cierra la pestana": "ctrl+w",
    "nueva pestana": "ctrl+t",
    "reabre la pestana": "ctrl+shift+t",
    "siguiente pestana": "ctrl+tab",
    "pestana anterior": "ctrl+shift+tab",
    "muestra el escritorio": "win+d",
    "captura de pantalla": "win+shift+s",
    "cambia de ventana": "alt+tab"
  }
}